# ==============================================================================
# AlmaConnect — Environment Configuration
# Copy to .env.local for local development or configure in Vercel Project Settings
# ==============================================================================

# Public Supabase Connection (safe for browser bundle)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Private Supabase Service Role (SERVER ONLY - never expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# PostgreSQL Connections
# DATABASE_URL -> Supabase Supavisor Transaction Pooler (port 6543) for serverless runtime
# DIRECT_URL   -> Direct PostgreSQL connection (port 5432) for drizzle-kit migrations
DATABASE_URL=
DIRECT_URL=

# Cryptographic secrets (generate with: openssl rand -hex 32)
VOUCH_HMAC_SECRET=dev-almaconnect-vouch-hmac-secret-change-in-prod
DEMO_SESSION_SECRET=dev-almaconnect-demo-session-secret-change-in-prod

# Set to "true" to enable one-click Student / Pending Alum / Verified Alum / Dean Demo Switcher
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_APP_URL=http://localhost:3000
